# syntax=docker/dockerfile:1
#
# Android-only build environment. The desktop Meson/Flatpak workflow does not
# use this image and must not depend on it.
#
# Build with:
#   podman build -f build-aux/android/Containerfile \
#     -t localhost/fractal-android-builder:dev .

FROM rust:1.93.0-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG ANDROID_COMMANDLINE_TOOLS_VERSION=13114758
ARG ANDROID_COMMANDLINE_TOOLS_SHA256=7ec965280a073311c339e571cd5de778b9975026cfcbe79f2b1cdcb1e15317ee
ARG ANDROID_NDK_VERSION=27.2.12479018
ARG ANDROID_PLATFORM=35
ARG ANDROID_BUILD_TOOLS_VERSION=35.0.0
ARG MESON_VERSION=1.9.0
ARG BLUEPRINT_COMPILER_VERSION=0.18.0
# Pinned after `git ls-remote` on 2026-07-25. Do not replace with a branch.
ARG PIXIEWOOD_COMMIT=00b1862b6434a8778557dc3d3074f43f5fdead1b

ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION}
ENV ANDROID_STUDIO_DIR=/opt/android-studio
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/usr/local/cargo/bin:${PATH}
ENV PIXIEWOOD_HOME=/opt/gtk-android-builder

# Pixiewood's documented host dependencies, plus the tools needed by Fractal's
# Meson/Blueprint build. Android Studio is intentionally not installed: the
# future Pixiewood manifest must use pre-generated icon assets, not its
# Android-Studio-only SVG converter.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gir1.2-appstream-1.0 \
        glslc \
        gobject-introspection \
        libglib-object-introspection-perl \
        libglib-perl \
        libglib2.0-dev-bin \
        libipc-run-perl \
        libjson-perl \
        libset-scalar-perl \
        libxml-libxml-perl \
        libxml-libxslt-perl \
        libxml2-utils \
        make \
        ninja-build \
        openjdk-17-jdk-headless \
        pkg-config \
        python3-pip \
        sassc \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Meson 1.9 is required for `android_exe_type`; Debian Bookworm's package is
# older. Keep this isolated from the host by installing it into the image.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        meson==${MESON_VERSION} \
        blueprint-compiler==${BLUEPRINT_COMPILER_VERSION}

RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools \
    && curl --fail --location --silent --show-error \
        --output /tmp/android-commandline-tools.zip \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_COMMANDLINE_TOOLS_VERSION}_latest.zip" \
    && echo "${ANDROID_COMMANDLINE_TOOLS_SHA256}  /tmp/android-commandline-tools.zip" | sha256sum --check --strict \
    && unzip -q /tmp/android-commandline-tools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools \
    && mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest \
    && rm /tmp/android-commandline-tools.zip \
    && yes | sdkmanager --sdk_root=${ANDROID_SDK_ROOT} --licenses > /dev/null \
    && sdkmanager --sdk_root=${ANDROID_SDK_ROOT} \
        "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
        "ndk;${ANDROID_NDK_VERSION}" \
        "platform-tools" \
        "platforms;android-${ANDROID_PLATFORM}"

RUN rustup target add aarch64-linux-android \
    && git clone https://github.com/sp1ritCS/gtk-android-builder.git /tmp/gtk-android-builder \
    && git -C /tmp/gtk-android-builder checkout --detach ${PIXIEWOOD_COMMIT} \
    && git -C /tmp/gtk-android-builder rev-parse HEAD > /tmp/gtk-android-builder/REVISION \
    && make -C /tmp/gtk-android-builder prefix=/usr/local install \
    && rm -rf /tmp/gtk-android-builder

WORKDIR /workspace

CMD ["bash"]
